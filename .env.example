# =====================================================================
# HoneyVault environment variables
# Copy to .env at the REPO ROOT. backend/, honeychecker/ and frontend/
# all read this single file. NEVER commit .env.
# Generate secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# =====================================================================

# ---------------- Common ----------------
# development | staging | production
APP_ENV=development
LOG_LEVEL=INFO
# Enables /api/attack/* demo endpoints and the seeded demo account
DEMO_MODE=true

# ---------------- Backend API (backend/) ----------------
API_PORT=8000
# Local: SQLite. Neon example:
# postgresql+psycopg://USER:PASSWORD@ep-xxxx.aws.neon.tech/honeyvault?sslmode=require
DATABASE_URL=sqlite:///./honeyvault.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# stub (Phase 0-1) | real (Phase 2+)
HONEYCORE_IMPL=stub
# default | server_lite | demo
VAULT_KDF_PROFILE=default
HONEYWORDS_K=10
HONEYWORDS_KDF_PROFILE=server_lite
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_UNLOCK=10/minute
ADMIN_USERNAME=admin
ADMIN_LOGIN_PASSWORD=change-me
DEMO_USERNAME=demo
DEMO_LOGIN_PASSWORD=change-me
DEMO_MASTER_PASSWORD=change-me
PCFG_PASSWORD_MODEL_PATH=honeycore/models/pcfg_password_v1.json.gz
PCFG_USERNAME_MODEL_PATH=honeycore/models/pcfg_username_v1.json.gz
EVAL_RESULTS_PATH=eval/results/latest.json
# 32 random bytes, base64. Wraps users' ECC identity private keys.
KEY_WRAP_SECRET=
# Base64 of PEM files produced in pki/out/
ROOT_CA_CERT_B64=
ISSUING_CA_CERT_B64=
ISSUING_CA_KEY_B64=

# ---------------- Backend -> Honeychecker ----------------
HONEYCHECKER_URL=http://localhost:8001
# plain (local dev) | mtls (docker-compose) | signed (Render)
HONEYCHECKER_TRANSPORT=plain
HONEYCHECKER_TIMEOUT_SECONDS=5
# mtls mode: file paths (relative to backend/)
HC_CLIENT_CERT_PATH=../pki/out/api-client.crt
HC_CLIENT_KEY_PATH=../pki/out/api-client.key
HC_CA_CERT_PATH=../pki/out/root-ca.crt
# signed mode: base64 PEM
HC_CLIENT_CERT_B64=
HC_CLIENT_KEY_B64=

# ---------------- Honeychecker service (honeychecker/) ----------------
HC_PORT=8001
HC_DATABASE_URL=sqlite:///./honeychecker.db
# must match HONEYCHECKER_TRANSPORT
HC_TRANSPORT=plain
HC_ALLOWED_CLIENT_CN=honeyvault-api
HC_SERVER_CERT_PATH=../pki/out/honeychecker-server.crt
HC_SERVER_KEY_PATH=../pki/out/honeychecker-server.key
HC_TRUSTED_CA_CERT_PATH=../pki/out/root-ca.crt
HC_TRUSTED_CA_CERT_B64=
HC_ISSUING_CA_CERT_B64=

# ---------------- Frontend (Vite exposes only VITE_*) ----------------
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCKS=true
VITE_DEMO_MODE=true
VITE_APP_NAME=HoneyVault